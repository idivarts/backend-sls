rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /{path=**}/applications/{applicationId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/invitations/{invitationId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/orgMembers/{memberId} {
      allow read: if isAuthenticated();
    }

    match /scrapped-socials/{socialId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    // Reverse index: platformAccountId -> connected brand/user + social.
    // Written/read server-side only (inbox webhook routing). Admin SDK bypasses.
    match /socialAccountIndex/{platformAccountId} {
      allow read, write: if false;
    }
    match /agency-hires/{hireId} {
      allow read, write: if isAuthenticated();
    }

    // ── Public share links ────────────────────────────────────────────────
    // Maps an unguessable token → a shared Strategy / Calendar month / Content.
    // Anyone (anonymous included) may resolve an ENABLED link; disabling it
    // (enabled=false) revokes public access. Only content managers of the
    // owning brand may create/toggle a link.
    match /shareLinks/{token} {
      allow read:   if resource.data.enabled == true;
      allow create: if isAuthenticated() &&
                       (canManageContent(request.resource.data.brandId) ||
                        canManageContentStrategy(request.resource.data.brandId));
      allow update, delete: if isAuthenticated() &&
                       (canManageContent(resource.data.brandId) ||
                        canManageContentStrategy(resource.data.brandId));
    }

    // ── AI chat conversations ─────────────────────────────────────────────
    // Author-only. The app subscribes directly to these for first load +
    // pagination (Firestore is the source of truth for displayed chat content);
    // the WebSocket only drives the live typing feel. All writes are performed
    // server-side via the Admin SDK, so clients get read-only access. userId is
    // denormalized onto each message doc so the messages rule needs no parent
    // get().
    match /ai_conversations/{conversationId} {
      allow read:  if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;

      match /messages/{messageId} {
        allow read:  if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    // ── Canva Connect OAuth tokens ────────────────────────────────────────
    // canvaConnections/{managerId}. Holds a brand-member's Canva access/refresh
    // tokens. FULLY backend-only — tokens must never reach the client, so both
    // read and write are denied; the app learns connection state via a backend
    // status endpoint, not by reading this doc.
    match /canvaConnections/{managerId} {
      allow read, write: if false;
    }

    // Transient OAuth-state records correlating a Canva auth attempt to its
    // public callback. Backend-only.
    match /canvaOauthStates/{state} {
      allow read, write: if false;
    }

    // ── Music library (shared soundtrack catalog) ─────────────────────────
    // musicLibrary/{trackId}. Curated, commercially-licensed tracks generated
    // via the seed script (Admin SDK). Readable by any authenticated user for
    // the soundtrack browser; clients never write.
    match /musicLibrary/{trackId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── AI model config ───────────────────────────────────────────────────
    // Public catalog of available AI models + per-task allowed-model lists
    // (docs: ai_config/models, ai_config/tasks). Readable by ANY authenticated
    // user, including Firebase anonymous sessions (so pre-auth screens can load
    // the model list without an API call). Seeded/edited server-side via the
    // Admin SDK (scripts/seed_ai_config) — clients never write.
    match /ai_config/{document} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Generative-media capability registry ──────────────────────────────
    // mediaModels/{modelId}. What each image/video/stock model can do: start
    // and end frames, duration bounds, aspect ratios, estimated cost, minimum
    // plan. Read by the app so the composer can offer only the controls a
    // chosen model actually supports — an end-frame slot on a model without
    // keyframes is a control that takes the user's money and ignores them.
    //
    // Writes are server-only, and that is the point rather than an aside: the
    // `enabled` field is a REVIEW GATE. The catalog sync inserts newly
    // published models with enabled=false and never flips it, so a model
    // nobody has looked at cannot start spending money. A client able to write
    // here could enable one.
    match /mediaModels/{modelId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    match /collaborations-invites/{collabUserId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    match /connections/{userId} {
      allow read: if isAuthenticated();
      // allow write: if isAuthenticated();
    }
    match /userImages/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Stores data about influencers and creators
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId && !doesManagerExists(userId);
      allow update, delete: if isAuthenticated() && request.auth.uid == userId && validateUserUpdate();

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated();
      }
      match /socials/{socialId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
      match /invitations/{inviteUserId} {
        allow read: if isAuthenticated();
        allow update: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Stores all brand managers
    match /managers/{managerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == managerId && !doesUserExists(managerId);
      allow update, delete: if isAuthenticated() && request.auth.uid == managerId;

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == managerId;
        allow write: if isAuthenticated();
      }
    }

    // Stores all brands
    match /brands/{brandId} {
      allow read: if isAuthenticated();
      // Brand documents are created server-side only via /api/v2/brands/create
      // (Admin SDK bypasses rules). Clients used to call addDoc() directly
      // during onboarding; that path no longer exists. Updates remain client-
      // writable for brand members; deletion is backend-only (HardDeleteBrand).
      allow create: if false;
      allow update: if isAuthenticated();
      allow delete: if false;

      match /socials/{socialId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
      match /socialAccounts/{accountId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
      // Access tokens are sensitive — server-only (Admin SDK bypasses rules).
      // Never readable/writable by clients.
      match /socialTokens/{accountId} {
        allow read, write: if false;
      }

      // Analytics cache + daily snapshots. Written/read server-side only.
      // Admin SDK bypasses these rules.
      match /analyticsCache/{cacheId} {
        allow read, write: if false;
      }
      match /analyticsSnapshots/{snapshotId} {
        allow read, write: if false;
      }

      // Analytics overview — computed async by the social_sqs worker. Read: any
      // brand member (the dashboard subscribes live). Writes are backend-only.
      match /analyticsOverview/{range} {
        allow read:  if isAuthenticated() && isBrandMember(brandId);
        allow write: if false;
      }

      // Inbox conversations (DMs + comments). Read: any brand member. Writes go
      // through the backend (Admin SDK), so clients never write directly.
      match /inbox/{conversationId} {
        allow read:  if isAuthenticated() && isBrandMember(brandId);
        allow write: if false;
      }

      // Inbox media (published posts/reels) — populated async by the social_sqs
      // worker. Read: any brand member (the Media tab subscribes live). Backend-only writes.
      match /inboxMedia/{mediaId} {
        allow read:  if isAuthenticated() && isBrandMember(brandId);
        allow write: if false;
      }

      // ── Design System ────────────────────────────────────────────────────
      // The brand's single design/brand standard (one doc, id "main"): colors,
      // typography, logos, imagery style, voice & tone and content rules, fed
      // into every AI generation so output stays on-brand. Read: any brand
      // member. Mutate: content managers (canManageContent) — the same holders
      // who tune how content is produced. The editor UI writes this doc directly
      // (client-writable); the AI reads it via the backend model and may write a
      // draft via the Admin SDK (which bypasses these rules).
      match /designSystem/{docId} {
        allow read:                   if isAuthenticated() && isBrandMember(brandId);
        allow create, update, delete: if isAuthenticated() && canManageContent(brandId);
      }

      // ── Strategies ───────────────────────────────────────────────────────
      // Read: any brand member. Mutate: content-strategy capability holders
      // (owner / admin / content_manager).
      match /strategies/{strategyId} {
        // Read: any brand member, OR anyone when the doc is publicly shared.
        allow read:                   if (isAuthenticated() && isBrandMember(brandId))
                                         || isResourcePublic();
        allow create, update, delete: if isAuthenticated() && canManageContentStrategy(brandId);

        // Strategy document-level and snippet comments.
        // Brand members always read/write. On a publicly-shared strategy a
        // logged-in NON-anonymous guest may also read and post (Tier 2) — but
        // anonymous (logged-out) viewers cannot.
        match /comments/{commentId} {
          allow read:   if (isAuthenticated() && isBrandMember(brandId))
                           || (isNonAnonAuthed() && strategyShared(brandId, strategyId));
          allow create: if ((isAuthenticated() && isBrandMember(brandId))
                           || (isNonAnonAuthed() && strategyShared(brandId, strategyId)))
                           && request.resource.data.authorId == request.auth.uid;
          // Only the comment author can edit or delete their own comment
          allow update, delete: if isAuthenticated() && isCommentAuthor() &&
                           (isBrandMember(brandId) || strategyShared(brandId, strategyId));
        }

        // Presence heartbeats — each manager can only write their own doc.
        // Also carries Yjs awareness state (cursor/selection) for live co-editing.
        match /presence/{managerId} {
          allow read:  if isAuthenticated() && isBrandMember(brandId);
          allow write: if isAuthenticated() && isBrandMember(brandId)
                         && request.auth.uid == managerId;
        }

        // Yjs CRDT update log (real-time collaboration, Phase 2).
        // Append-only base64 deltas + periodic compaction snapshots. Any brand
        // member may read (to sync); content-strategy capability holders may
        // append. Delete is allowed for the same holders so compaction can
        // prune superseded deltas after writing a snapshot.
        match /yupdates/{updateId} {
          allow read:   if isAuthenticated() && isBrandMember(brandId);
          allow create: if isAuthenticated() && canManageContentStrategy(brandId);
          allow delete: if isAuthenticated() && canManageContentStrategy(brandId);
        }
      }

      // ── Contents ─────────────────────────────────────────────────────────
      // Read: any brand member. Create/update: manage_content holders
      // (incl. content_creator). Delete: content managers/admins/owners only.
      match /contents/{contentId} {
        // Read: any brand member, OR anyone when the doc is publicly shared.
        allow read:           if (isAuthenticated() && isBrandMember(brandId))
                                 || isResourcePublic();
        allow create, update: if isAuthenticated() && canManageContent(brandId);
        allow delete:         if isAuthenticated() && canDeleteContent(brandId);

        // Content comments — shared between Calendar and Content detail page.
        // On a publicly-shared content a logged-in NON-anonymous guest may also
        // read and post (Tier 2); anonymous viewers cannot.
        match /comments/{commentId} {
          allow read:   if (isAuthenticated() && isBrandMember(brandId))
                           || (isNonAnonAuthed() && contentShared(brandId, contentId));
          allow create: if ((isAuthenticated() && isBrandMember(brandId))
                           || (isNonAnonAuthed() && contentShared(brandId, contentId)))
                           && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isAuthenticated() && isCommentAuthor() &&
                           (isBrandMember(brandId) || contentShared(brandId, contentId));
        }

        // Per-platform content variations (one doc per platform; doc ID == the
        // platform key). Same access policy as the parent content: any brand
        // member may read, AND any public viewer (anonymous included) when the
        // content is shared — mirroring the parent content's isResourcePublic()
        // read so the public share view can show the right per-platform copy.
        // manage_content holders create/update/delete.
        match /variations/{platform} {
          allow read:                   if (isAuthenticated() && isBrandMember(brandId))
                                           || contentShared(brandId, contentId);
          allow create, update, delete: if isAuthenticated() && canManageContent(brandId);
        }

        // ── AI Studio HTML design revisions (immutable) ────────────────────
        // brands/{brandId}/contents/{contentId}/designs/{revisionId}. Each holds
        // a self-contained HTML document. CLIENT-WRITABLE (HTML is not sensitive)
        // so deterministic text edits + the frontend-captured render (renderUrl)
        // are written directly by the app; the AI also writes via the Admin SDK.
        // Readable by any brand member, and by a public viewer when shared.
        match /designs/{revisionId} {
          allow read:           if (isAuthenticated() && isBrandMember(brandId))
                                   || contentShared(brandId, contentId);
          allow create, update: if isAuthenticated() && canManageContent(brandId);
        }

        // ── Composition (timeline) revisions ─────────────────────────────────
        // brands/{brandId}/contents/{contentId}/compositions/{revisionId}. Each
        // holds one immutable timeline: a sequence of clips, of which a whole
        // HTML design may be one. Client-writable like designs, because the
        // timeline editor composes them directly.
        //
        // The render fields are NOT writable here, unlike on a design. A design
        // revision's renderUrl can come from the app, which used to capture its
        // own export; a composition is only ever rendered on our own
        // infrastructure, after the wallet has been charged, so a client that
        // could write renderStatus/renderUrl could mark a render done that
        // never ran — and the publish pipeline reads exactly that field.
        match /compositions/{revisionId} {
          allow read:   if (isAuthenticated() && isBrandMember(brandId))
                           || contentShared(brandId, contentId);
          allow create: if isAuthenticated() && canManageContent(brandId)
                           && !request.resource.data.keys().hasAny(compositionRenderFields());
          allow update: if isAuthenticated() && canManageContent(brandId)
                           && !request.resource.data.diff(resource.data).affectedKeys()
                               .hasAny(compositionRenderFields());
        }

        // ── The Design Studio ────────────────────────────────────────────────
        // brands/{brandId}/contents/{contentId}/studios/{studioId} and its
        // scenes, renders and director runs.
        //
        // ⚠️ READ-ONLY TO CLIENTS, which is deliberately the opposite of
        // designs and compositions next door. Every scene write moves MEDIA
        // REFERENCE COUNTS — placing media increments, clearing decrements,
        // swapping moves only the difference — and those counts are what make
        // "archive, never hard-delete" enforceable. A client writing scenes
        // directly would have to maintain them on every one of a dozen edit
        // paths, and the first path that forgot would either strand media as
        // permanently un-archivable or let a sweep delete something still on
        // screen. Neither is recoverable by hand.
        //
        // The app loses nothing for it: it subscribes here for live state and
        // applies each edit optimistically, so a drag still lands instantly
        // while the write goes through /api/studio in the background.
        //
        // Public read follows the content's own share toggle, so a shared post
        // can show its scenes.
        match /studios/{studioId} {
          allow read:  if (isAuthenticated() && isBrandMember(brandId))
                          || contentShared(brandId, contentId);
          allow write: if false;

          match /scenes/{sceneId} {
            allow read:  if (isAuthenticated() && isBrandMember(brandId))
                            || contentShared(brandId, contentId);
            allow write: if false;
          }

          // A render's status and output. Written only by the worker, after
          // the wallet has been charged — the same reason a composition's
          // render fields are not client-writable.
          match /renders/{renderId} {
            allow read:  if isAuthenticated() && isBrandMember(brandId);
            allow write: if false;
          }

          // A director run: its plan, its node graph, what it cost. Read so
          // the storyboard can follow a run live; never written by a client,
          // because the plan is what authorises the spending.
          match /runs/{runId} {
            allow read:  if isAuthenticated() && isBrandMember(brandId);
            allow write: if false;
          }
        }
      }

      // ── Designs (Design Studio v3) ───────────────────────────────────────
      // brands/{brandId}/designs/{designId}. TOP-LEVEL under the brand, not
      // under a content: v3 makes a design its own object and keeps the link
      // to a content as an optional `contentId` FIELD. That is what lets it be
      // opened from the Playground section of the drawer, and what lets it
      // outlive the content it was made for.
      //
      // Read by any brand member — the studio subscribes live for render
      // progress, which is what makes a render survive a page reload.
      //
      // NOT client-writable, and deliberately so. The document carries the
      // render lifecycle and the pointer to the project in S3; a client able
      // to write renderStatus or projectPrefix could mark an unrendered design
      // done, or point it at another brand's files. Every mutation goes
      // through the backend (Admin SDK bypasses these rules).
      match /designs/{designId} {
        allow read:  if isAuthenticated() && isBrandMember(brandId);
        allow write: if false;
      }

      // ── The brand's media library ────────────────────────────────────────
      // brands/{brandId}/assets/{assetId}. Brand-scoped on purpose: an asset
      // uploaded while editing one post is meant to be reachable from another.
      //
      // Read by any brand member. NOT client-writable: an asset carries
      // provenance — a credit that must travel with it, a licence that forbids
      // re-hosting, a flag saying it may not be fed to a model — and a client
      // able to write those could strip a photographer's credit or mark
      // someone else's licensed photo as freely usable. Uploads are recorded
      // through POST /api/v2/brands/:brandId/assets, which stamps provenance
      // itself rather than accepting it.
      match /assets/{assetId} {
        allow read:  if isAuthenticated() && isBrandMember(brandId);
        allow write: if false;
      }

      // ── Per-brand rollups ───────────────────────────────────────────────
      // brands/{brandId}/aggregates/{name}. Today: `mediaUsage`, the brand's
      // storage total, maintained with atomic increments as media is filed and
      // archived.
      //
      // Read by any brand member — it is their own number, shown on settings.
      // NOT client-writable, and that is the whole point of it being a separate
      // document: it is a counter that will one day be billed from, and a
      // client able to write it could report any figure it liked.
      match /aggregates/{name} {
        allow read:  if isAuthenticated() && isBrandMember(brandId);
        allow write: if false;
      }

      // ── Generated audio (ElevenLabs music / voiceovers) ──────────────────
      // brands/{brandId}/generatedAudio/{audioId}. Written ONLY by the backend
      // (Admin SDK) after a metered generation; brand members read to preview.
      match /generatedAudio/{audioId} {
        allow read:  if isAuthenticated() && isBrandMember(brandId);
        allow write: if false;
      }

      // ── Calendar month public share toggle ───────────────────────────────
      // Stored at brands/{brandId}/calendarShares/{YYYY-MM}. Tracks whether a
      // month is publicly shared + the token. The month's content items are
      // served to public viewers by the backend (Admin SDK), so this doc only
      // gates the toggle state — readable by anyone when enabled.
      match /calendarShares/{month} {
        allow read:   if (isAuthenticated() && isBrandMember(brandId))
                         || (resource != null && resource.data.enabled == true);
        allow write:  if isAuthenticated() && canManageContent(brandId);
      }

      // ── Calendar month-level comments ────────────────────────────────────
      // Stored at brands/{brandId}/calendarComments/{YYYY-MM}/comments/{commentId}
      match /calendarComments/{month}/comments/{commentId} {
        allow read:   if isAuthenticated() && isBrandMember(brandId);
        allow create: if isAuthenticated() && isBrandMember(brandId);
        allow update, delete: if isAuthenticated() && isBrandMember(brandId) && isCommentAuthor();
      }

      match /members/{managerId} {
        allow read: if isAuthenticated();
        // Brand-member docs are seeded server-side together with the brand
        // (CreateBrand handler) and managed by CreateBrandMember /
        // DeleteBrandMember on the backend. Clients can update an existing
        // member (e.g. status), but cannot create or delete one directly —
        // creation must go through the backend so org seat limits and team
        // assignment stay consistent.
        allow create: if false;
        allow update: if isAuthenticated();
        allow delete: if false;
      }

      // ── Teams ────────────────────────────────────────────────────────────
      // Access units within a brand: each team holds a feature→privileges map
      // its members inherit. Any brand member may read; only members whose team
      // grants brand_admin:teams may mutate.
      match /teams/{teamId} {
        allow read:  if isAuthenticated() && isBrandMember(brandId);
        allow write: if isAuthenticated() && canManageBrandTeams(brandId);
      }

      match /notifications/{notificationId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Stores organizations — the top-level tenant above brands. Billing /
    // subscription lives here; each brand references its org via organizationId.
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      // Clients may edit org profile fields (e.g. name/image) but NEVER billing,
      // the token wallet, entitlements, or plan caps — those are written only by
      // the backend (Admin SDK, which bypasses rules). This stops a client from
      // self-granting tokens or flipping their own subscription to "active".
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['billing', 'tokenWallet', 'entitlements', 'planKey', 'maxBrands']);

      // Org membership + role. Named "orgMembers" (NOT "members") on purpose so
      // it does not collide with the brands/{brandId}/members collection-group
      // queries used by the brand switcher.
      match /orgMembers/{managerId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Webhook idempotency ledger (RevenueCat / Razorpay processed event ids).
    // Written only by the backend (Admin SDK bypasses rules); never exposed to
    // clients. Explicit server-only block to document intent.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // RevenueCat subscription-transaction ownership ledger (doc id = store
    // original transaction id). Written only by the backend to enforce that
    // subscriptions are not transferable between orgs; never exposed to
    // clients. Explicit server-only block to document intent.
    match /revenuecatTransactionOwners/{transactionId} {
      allow read, write: if false;
    }

    // Stores all collaborations
    match /collaborations/{collaborationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /applications/{applicationId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
      match /invitations/{invitationId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // // Stores groups created for collaborations
    // match /groups/{groupId} {
    //   allow read: if isAuthenticated();
    //   allow write: if isAuthenticated();
    //   match /messages/{messageId} {
    //     allow read: if isAuthenticated();
    //     allow write: if isAuthenticated();
    //   }
    // }

    // Stores contracts created for collaborations
    match /contracts/{contractId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      // // match /deliverables/{deliverableId} {
      // //   allow read, write: if isAuthenticated();
      // // }
      // // match /payments/{paymentId} {
      // //   allow read, write: if isAuthenticated();
      // // }
    }

    // ── Helper functions ────────────────────────────────────────────────────

    // ── Generative media jobs ────────────────────────────────────────────
    // mediaJobs/{jobId}, top-level and keyed by the PROVIDER's generation id.
    // Written only by the backend: the document records what the wallet was
    // charged and whether that charge has been refunded, so a client able to
    // write one could refund itself indefinitely. The app watches the
    // composition's clip rather than this.
    match /mediaJobs/{jobId} {
      allow read:  if false;
      allow write: if false;
    }

    // Fields on a composition revision that only the render worker may write.
    // Listed once so the create and update rules cannot drift apart.
    function compositionRenderFields() {
      return ['renderUrl', 'posterUrl', 'renderStatus', 'renderProgress',
              'renderError', 'renderJobId', 'renderStartedAt', 'renderedAt',
              'renderScale', 'renderChargedTokens'];
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // True for Firebase anonymous sessions (used by logged-out public viewers).
    function isAnonymous() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // True for a real (non-anonymous) logged-in user — i.e. an actual manager
    // account, which may or may not be a member of the shared brand.
    function isNonAnonAuthed() {
      return isAuthenticated() && !isAnonymous();
    }

    // True when the document being read carries an enabled public-share flag.
    // Used on the resource's own read rule (cheap field check, no extra read).
    function isResourcePublic() {
      return resource != null &&
        resource.data.get('publicShare', {}).get('enabled', false) == true;
    }

    // True when the given strategy is publicly shared (cross-doc lookup — used
    // only by the comments sub-rules, not the hot document read path).
    function strategyShared(brandId, strategyId) {
      return get(/databases/$(database)/documents/brands/$(brandId)/strategies/$(strategyId))
        .data.get('publicShare', {}).get('enabled', false) == true;
    }

    // True when the given content item is publicly shared.
    function contentShared(brandId, contentId) {
      return get(/databases/$(database)/documents/brands/$(brandId)/contents/$(contentId))
        .data.get('publicShare', {}).get('enabled', false) == true;
    }

    function isAdmin() {
      return true;
    }

    function doesManagerExists(uid) {
      return exists(/databases/$(database)/documents/managers/$(uid));
    }

    function doesUserExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    /**
     * Returns true if the calling user is a registered member of the given brand.
     * Checks for the manager doc under brands/{brandId}/members/{uid}.
     */
    function isBrandMember(brandId) {
      return exists(
        /databases/$(database)/documents/brands/$(brandId)/members/$(request.auth.uid)
      );
    }

    /**
     * The calling user's member doc data within the given brand.
     */
    function brandMemberData(brandId) {
      return get(
        /databases/$(database)/documents/brands/$(brandId)/members/$(request.auth.uid)
      ).data;
    }

    /**
     * True while the member has no team assigned (pre-migration legacy member).
     * Such members are allowed through until scripts/migrate-teams-v2 runs —
     * mirrors the backend's transition shim. Remove once migration completes.
     */
    function isLegacyBrandMember(brandId) {
      return !('teamId' in brandMemberData(brandId))
        || brandMemberData(brandId).teamId == null
        || brandMemberData(brandId).teamId == '';
    }

    /**
     * The privileges map (feature -> [privilege]) of the team the caller belongs
     * to. Only call when the member has a team (guard with isLegacyBrandMember).
     */
    function callerTeamPrivileges(brandId) {
      return get(
        /databases/$(database)/documents/brands/$(brandId)/teams/$(brandMemberData(brandId).teamId)
      ).data.privileges;
    }

    /**
     * Returns true if the caller's team grants `priv` under `feature`. Legacy
     * members (no team) are allowed through during the migration window.
     * Relies on Firestore rules' short-circuit evaluation so the team get() is
     * skipped for legacy members.
     */
    function hasFeaturePrivilege(brandId, feature, priv) {
      return isBrandMember(brandId) && (
        isLegacyBrandMember(brandId) || (
          feature in callerTeamPrivileges(brandId) &&
          priv in callerTeamPrivileges(brandId)[feature]
        )
      );
    }

    // Team administration: brand_admin:teams.
    function canManageBrandTeams(brandId) {
      return hasFeaturePrivilege(brandId, 'brand_admin', 'teams');
    }

    // Content-strategy mutations: strategy admin (create + edit) or editor.
    function canManageContentStrategy(brandId) {
      return hasFeaturePrivilege(brandId, 'strategy', 'admin')
        || hasFeaturePrivilege(brandId, 'strategy', 'editor');
    }

    // Content create/update: content create_edit or editor.
    function canManageContent(brandId) {
      return hasFeaturePrivilege(brandId, 'content', 'create_edit')
        || hasFeaturePrivilege(brandId, 'content', 'editor');
    }

    // Content delete: content create_edit (editors/viewers cannot delete).
    function canDeleteContent(brandId) {
      return hasFeaturePrivilege(brandId, 'content', 'create_edit');
    }

    /**
     * Returns true if the calling user authored the comment being updated/deleted.
     * Used to enforce that managers can only edit or delete their own comments.
     */
    function isCommentAuthor() {
      return request.auth.uid == resource.data.authorId;
    }

    function validateUserUpdate() {
      return (
        request.resource.data.isChatConnected == resource.data.isChatConnected ||
        !(resource.data.keys().hasAll(['isChatConnected']))
      );
    }
  }
}
