{
  "name": "@trendly/render-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Server-side render worker: a design's HTML -> PNG slides or an MP4, in headless Chromium + FFmpeg.",
  "main": "dist/services/render-worker/src/lambda.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render": "node dist/services/render-worker/src/cli.js",
    "test": "node --test dist/services/render-worker/src/**/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "firebase-admin": "^13.0.0",
    "playwright": "1.63.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
