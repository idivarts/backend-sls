# Serverless directories
.serverless

# golang output binary directory
bin

# golang vendor (dependencies) directory
vendor

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
node_modules
.bin
dist
**/service-account**.json
.DS_Store
applications*.csv
key-secrets*.json
new-leads.csv
new-notion-leads.csv
env.local.sh

# Binaries built by `go build ./scripts/<name>` land here, named after the
# package directory — a 49MB one reached a commit this way.
/seed-media-models
/backfill-org-brands
/billing-cron

# The render worker vendors GSAP so a Hyperframes render needs no network.
# The bare `vendor` rule above is the Go convention and silently swallowed it:
# `git add -A` said nothing, the commit looked clean, and the Docker build
# failed on a COPY of a path that was never in the context. Negated here
# rather than narrowing the Go rule, so Go vendoring keeps working.
!services/render-worker/vendor/
!services/render-worker/vendor/**
